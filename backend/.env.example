# MongoDB Atlas / MongoDB server connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=test

# Generate a long random secret before production deployment
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_SECONDS=604800

# Upload and CORS settings
UPLOAD_MAX_MB=200
UPLOAD_DB_MAX_MB=10
CORS_ALLOW_ALL=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com
PORT=4000
APP_TIMEZONE=Asia/Bangkok
# GPS / route services (เปลี่ยนเป็นเซิร์ฟเวอร์ขององค์กรได้เมื่อใช้งานปริมาณมาก)
MAP_GEOCODING_URL=https://nominatim.openstreetmap.org
MAP_ROUTING_URL=https://router.project-osrm.org
MAP_USER_AGENT=TestSystem/2026.1

# แนะนำสำหรับการค้นหาบริษัท/สถานที่ทั่วโลกและระยะทางระดับ Google Maps
# เปิด Places API (New), Geocoding API และ Routes API ใน Google Cloud Console
GOOGLE_MAPS_API_KEY=

# Generate a separate high-entropy secret (at least 32 chars) for /adminnakub
ADMIN_RECOVERY_KEY=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARS
