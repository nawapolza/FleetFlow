# Copy this file to backend/.env for local use. Never commit actual credentials.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/test?retryWrites=true&w=majority
MONGODB_DB=test
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_RECOVERY_KEY=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_EXPIRE_SECONDS=604800
CORS_ALLOW_ALL=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://fleetflow-1-ajlc.onrender.com
APP_TIMEZONE=Asia/Bangkok
UPLOAD_MAX_MB=200
UPLOAD_DB_MAX_MB=10
